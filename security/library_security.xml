<odoo>
  <data noupdate="1">
    <record id="group_library_user" model="res.groups">
      <field name="name">Library User</field>
    </record>

    <record id="group_library_manager" model="res.groups">
      <field name="name">Library Manager</field>
    </record>

    <record id="group_library_book_user" model="ir.rule">
      <field name="name">Library Book User Rule</field>
      <field name="model_id" ref="model_library_book"/>
      <field name="domain_force">[('is_available', '=', 'True')]</field>
      <field name="groups" eval="[(4, ref('library_module.group_library_user'))]"/>
    </record>
  </data>
</odoo>