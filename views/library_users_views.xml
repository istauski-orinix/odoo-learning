<odoo>
    <record id="view_library_users_list" model="ir.ui.view">
        <field name="name">library.users.list</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <list>
                <field name="title"/>
                <field name="author"/>
                <field name="is_available"/>
                <field name="reading_progress" widget="progressbar"/>
            </list>
        </field>
    </record>

    <record id="view_library_users_form" model="ir.ui.view">
        <field name="name">library.users.form</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="title"/>
                        <field name="description"/>
                        <field name="genres" widget="many2many_tags"/>
                        <field name="author"/>
                        <field name="ISBN"/>
                        <field name="full_title"/>
                        <field name="page_number"/>
                        <field name="state"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,archived,featured,available,else"
                   statusbar_colors="draft:yellow,archived:blue,featured:red, available:green, else:gray"/>
                        <field name="is_available"/>
                        <field name="is_hefty"/>
                        <field name="publisher_id"/>
                    </group>
                    <field name="cover_image" widget="image"/>
                    <button name="action_mark_as_featured"
                        string="Confirm"
                        type="object"/>
                    <button name="action_mark_as_archived"
                        string="Archive"
                        type="object"
                        invisible="state != 'draft'"/>
                </sheet>
              </form>
        </field>
    </record>

    <record id="view_library_users_search" model="ir.ui.view">
        <field name="name">library.book.search</field>
        <field name="model">library.book</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <filter name="is_available" string="Available" domain="[('is_available','=','True')]"/>
            </search>
        </field>
    </record>

    <record id="inherit_school_student_list" model="ir.ui.view">
        <field name="name">library.book.list.inherit</field>
        <field name="model">library.book</field>
        <field name="inherit_id" ref="library_module.view_library_users_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="ISBN"/>
            </xpath>
            <xpath expr="//field[@name='is_available']" position="replace">
                <field name="is_available" string="Book Status"/>
            </xpath>
        </field>
    </record>
</odoo>